<?xml version="1.0" encoding="utf-8"?>
<!--
  Reemplaza el values-night de flutter create (Theme.Black): la app tiene una sola paleta clara, así que con el
  teléfono en modo oscuro el arranque y la ventana siguen claros y los íconos de la barra de estado no salen blancos.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
