# URL de la API vista desde el navegador (incluye /api/v1).
# Recomendado: relativa, para que la web y la API compartan origen y la cookie de sesión
# (HttpOnly, SameSite=Strict) viaje sin CORS. Así funciona también en el contenedor único.
NEXT_PUBLIC_API_URL=/api/v1
# A dónde reenvía la web las rutas /api/* (en desarrollo, la API local).
API_INTERNAL_URL=http://localhost:3000
# Estilo del mapa (MapLibre). OpenFreeMap no requiere API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Sentry (H05.4): sin DSN no se carga el SDK. Se fijan al compilar (NEXT_PUBLIC_*). Entorno: pruebas o produccion.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=pruebas
# NEXT_PUBLIC_SENTRY_RELEASE=
