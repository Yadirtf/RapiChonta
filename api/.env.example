# Puerto HTTP de la API
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:3001
# PostgreSQL con PostGIS. Si se deja vacío, la API usa un repositorio en memoria con datos de ejemplo.
DATABASE_URL=postgresql://rapichonta:rapichonta@localhost:5432/rapichonta?schema=public
# Secreto para firmar tokens (fase 1: autenticación)
JWT_SECRET=cambia-esto
