# Puerto HTTP de la API
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:3001
# PostgreSQL con PostGIS. Sin base de datos solo funciona el mapa (datos en memoria); identidad y panel la necesitan.
DATABASE_URL=postgresql://rapichonta:rapichonta@localhost:5432/rapichonta?schema=public

# ── Identidad y acceso (E01) ──
# Secreto de los tokens: al menos 32 caracteres (openssl rand -hex 32). Obligatorio en producción.
JWT_SECRET=
# Secreto para el hash de los códigos OTP (opcional; si falta se usa JWT_SECRET).
OTP_PEPPER=
# Proveedor de códigos: console (el código se escribe en el log) o twilio (Twilio Verify, SMS y WhatsApp).
OTP_PROVIDER=console
# Solo pruebas sin proveedor de SMS: devuelve el código en la respuesta. NUNCA en producción real.
OTP_EXPOSE_CODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Cookie de refresco con Secure (por defecto: true solo con NODE_ENV=production).
# COOKIE_SECURE=false

# ── Semilla (se ejecuta al arrancar el contenedor; es idempotente) ──
# Primer administrador: se crea solo si el número no existe. Después se crean los demás desde el panel.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Establecimientos de ejemplo para probar el mapa (exige el administrador inicial).
SEED_DEMO_DATA=false
