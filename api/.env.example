# Puerto HTTP de la API
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:3001
# PostgreSQL con PostGIS. Sin base de datos solo funciona el mapa (datos en memoria); identidad y panel la necesitan.
DATABASE_URL=postgresql://rapichonta:rapichonta@localhost:5432/rapichonta?schema=public

# ── Identidad y acceso (E01) ──
# Secreto de los tokens: al menos 32 caracteres (openssl rand -hex 32). Obligatorio en producción.
JWT_SECRET=
# Secreto para el hash de los códigos OTP (opcional; si falta se usa JWT_SECRET).
OTP_PEPPER=
# Proveedor de códigos: console (el código se escribe en el log) o twilio (Twilio Verify, SMS y WhatsApp).
OTP_PROVIDER=console
# Solo pruebas sin proveedor de SMS: devuelve el código en la respuesta. NUNCA en producción real.
OTP_EXPOSE_CODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Cookie de refresco con Secure (por defecto: true solo con NODE_ENV=production).
# COOKIE_SECURE=false

# ── Semilla (se ejecuta al arrancar el contenedor; es idempotente) ──
# Primer administrador: se crea solo si el número no existe. Después se crean los demás desde el panel.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Establecimientos de ejemplo para probar el mapa (exige el administrador inicial).
SEED_DEMO_DATA=false

# ── Archivos: fotos de productos y logos (E02) ──
# database (por defecto): los bytes van a la tabla file_contents. s3: bucket S3 compatible (Cloudflare R2).
FILE_STORAGE=database
# Firma de las URLs de los archivos (opcional; si falta se deriva de JWT_SECRET).
FILES_SIGNING_SECRET=
# Solo con FILE_STORAGE=s3. En R2: https://<cuenta>.r2.cloudflarestorage.com y región auto. El bucket necesita CORS para PUT desde la web.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Carga del catálogo por CSV (npm run catalog:import -- <carpeta>) ──
# Autor de los cambios (por defecto el primer administrador) y municipio DANE (por defecto 86885, Villagarzón).
CATALOG_IMPORT_USER_ID=
CATALOG_IMPORT_MUNICIPALITY=86885

# ── Negocio (E03) ──
# Consulta diaria de las tasas USD/EUR para el precio aproximado. false la apaga (el panel puede forzarla).
EXCHANGE_RATES_ENABLED=true

# ── Observabilidad (E05, H05.4) ──
# Logs: json (una línea JSON por evento, con requestId) o pretty. Por defecto json con NODE_ENV=production.
# LOG_FORMAT=json
# Sentry: sin DSN no se envía nada. Entorno: pruebas o produccion. Versión: por defecto rapichonta-api@<versión de package.json>.
SENTRY_DSN=
SENTRY_ENVIRONMENT=pruebas
# SENTRY_RELEASE=

# ── Notificaciones push (E06) ──
# Sin credenciales de un proveedor, sus teléfonos no reciben push (el aviso queda en la bandeja de la app).
# FCM (Android con Google, iOS): JSON de la cuenta de servicio de Firebase, tal cual o en base64.
FCM_SERVICE_ACCOUNT=
# Huawei Push Kit (teléfonos sin Google): AppGallery Connect → Mi proyecto → General.
HMS_APP_ID=
# Client ID (vacío = el App ID) y Client secret.
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
# Categoría de autoclasificación aprobada por Huawei (p. ej. EXPRESS). Sin ella EMUI muestra los avisos sin sonido.
HMS_MESSAGE_CATEGORY=
# Actividad que abre el aviso (paquete/.Actividad); por defecto la de la app compilada en CI.
HMS_CLICK_ACTIVITY=
# fake: no envía nada y escribe los avisos en el log (pruebas locales).
PUSH_PROVIDERS_MODE=
# Bandeja de salida: revisión con pedidos en curso y revisión de respaldo sin ellos (segundos).
NOTIFICATIONS_ACTIVE_SWEEP_SECONDS=5
NOTIFICATIONS_IDLE_SWEEP_SECONDS=600
