  fundingMode     FundingMode    @relation(fields: [fundingModeId], references: [id], onDelete: Restrict)
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([courierUserId, effectiveOn])
  @@map("courier_funding_modes")
}

model VehicleType {
