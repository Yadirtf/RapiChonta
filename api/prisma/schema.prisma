  legalDocumentVersion   LegalDocumentVersion @relation(fields: [legalDocumentVersionId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_consents")
}

model DataRequestType {
  id            Int           @id @default(autoincrement()) @db.SmallInt
  code          String        @unique @db.VarChar(40)
  sortOrder     Int           @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?     @map("deactivated_at") @db.Timestamptz(6)
  requests      DataRequest[]

  @@map("data_request_types")
}

model DataRequestStatus {
  id            Int           @id @default(autoincrement()) @db.SmallInt
  code          String        @unique @db.VarChar(40)
  sortOrder     Int           @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?     @map("deactivated_at") @db.Timestamptz(6)
  isInitial     Boolean       @map("is_initial")
  isTerminal    Boolean       @map("is_terminal")
  requests      DataRequest[]

  @@map("data_request_statuses")
}

/// Solicitudes del titular (Ley 1581): consulta, corrección, eliminación, revocación.
model DataRequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId         String            @map("person_id") @db.Uuid
  requestTypeId    Int               @map("request_type_id") @db.SmallInt
