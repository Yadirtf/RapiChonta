// ═══════════════════════════ E02 · Establecimientos y menús ═══════════════════════════

model EstablishmentStatus {
  id              Int                             @id @default(autoincrement()) @db.SmallInt
  code            String                          @unique @db.VarChar(40)
  sortOrder       Int                             @map("sort_order") @db.SmallInt
  deactivatedAt   DateTime?                       @map("deactivated_at") @db.Timestamptz(6)
  isInitial       Boolean                         @map("is_initial")
  isTerminal      Boolean                         @map("is_terminal")
  isVisibleOnMap  Boolean                         @map("is_visible_on_map")
  acceptsOrders   Boolean                         @map("accepts_orders")
  establishments  Establishment[]
  transitionsFrom EstablishmentStatusTransition[] @relation("EstablishmentTransitionFrom")
  transitionsTo   EstablishmentStatusTransition[] @relation("EstablishmentTransitionTo")

  @@map("establishment_statuses")
}

/// Cambios de estado permitidos del establecimiento (nivel simple: el cambio queda en audit_logs).
model EstablishmentStatusTransition {
  fromStatusId Int                 @map("from_status_id") @db.SmallInt
  toStatusId   Int                 @map("to_status_id") @db.SmallInt
  fromStatus   EstablishmentStatus @relation("EstablishmentTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatus     EstablishmentStatus @relation("EstablishmentTransitionTo", fields: [toStatusId], references: [id], onDelete: Restrict)

  @@id([fromStatusId, toStatusId])
  @@map("establishment_status_transitions")
}

model Establishment {
  id              String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId  Int                                     @map("municipality_id")
  name            String                                  @db.VarChar(120)
  addressLine     String                                  @map("address_line") @db.VarChar(200)
  location        Unsupported("geography(Point, 4326)")
  area            Unsupported("geography(Polygon, 4326)")
  logoFileId      String?                                 @map("logo_file_id") @db.Uuid
  statusId        Int                                     @map("status_id") @db.SmallInt
  createdByUserId String                                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  municipality    Municipality                            @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  logoFile        File?                                   @relation(fields: [logoFileId], references: [id], onDelete: Restrict)
  status          EstablishmentStatus                     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy       User                                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  categoryLinks EstablishmentCategoryLink[]
  phones        EstablishmentPhone[]
  menuSections  MenuSection[]
  products      Product[]
  orders        Order[]

  @@index([location], type: Gist)
  @@index([area], type: Gist)
  @@index([municipalityId])
  @@map("establishments")
}

model EstablishmentCategory {
  id            Int                                @id @default(autoincrement()) @db.SmallInt
  code          String                             @unique @db.VarChar(40)
  icon          String                             @db.VarChar(40)
  sortOrder     Int                                @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?                          @map("deactivated_at") @db.Timestamptz(6)
  translations  EstablishmentCategoryTranslation[]
  links         EstablishmentCategoryLink[]

  @@map("establishment_categories")
}

model EstablishmentCategoryTranslation {
  categoryId Int                   @map("category_id") @db.SmallInt
  languageId Int                   @map("language_id") @db.SmallInt
  name       String                @db.VarChar(80)
  category   EstablishmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language   Language              @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([categoryId, languageId])
  @@map("establishment_category_translations")
}

model EstablishmentCategoryLink {
  establishmentId String                @map("establishment_id") @db.Uuid
  categoryId      Int                   @map("category_id") @db.SmallInt
  isPrimary       Boolean               @map("is_primary")
  establishment   Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category        EstablishmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([establishmentId, categoryId])
  @@index([categoryId])
  @@map("establishment_category_links")
}

model EstablishmentPhone {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  phoneE164       String        @map("phone_e164") @db.VarChar(16)
  label           String?       @db.VarChar(40)
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, phoneE164])
  @@map("establishment_phones")
}

model MenuSection {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  establishmentId String                   @map("establishment_id") @db.Uuid
  sortOrder       Int                      @map("sort_order") @db.SmallInt
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt   DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  establishment   Establishment            @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  translations    MenuSectionTranslation[]
  products        Product[]

  @@unique([id, establishmentId])
  @@index([establishmentId])
  @@map("menu_sections")
}

model MenuSectionTranslation {
  menuSectionId String      @map("menu_section_id") @db.Uuid
  languageId    Int         @map("language_id") @db.SmallInt
  name          String      @db.VarChar(80)
  menuSection   MenuSection @relation(fields: [menuSectionId], references: [id], onDelete: Cascade)
  language      Language    @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([menuSectionId, languageId])
  @@map("menu_section_translations")
}

model ProductStatus {
  id              Int                       @id @default(autoincrement()) @db.SmallInt
  code            String                    @unique @db.VarChar(40)
  sortOrder       Int                       @map("sort_order") @db.SmallInt
  deactivatedAt   DateTime?                 @map("deactivated_at") @db.Timestamptz(6)
  isInitial       Boolean                   @map("is_initial")
  isTerminal      Boolean                   @map("is_terminal")
  isVisible       Boolean                   @map("is_visible")
  isOrderable     Boolean                   @map("is_orderable")
  products        Product[]
  transitionsFrom ProductStatusTransition[] @relation("ProductTransitionFrom")
  transitionsTo   ProductStatusTransition[] @relation("ProductTransitionTo")

  @@map("product_statuses")
}

/// Cambios de disponibilidad permitidos del producto.
model ProductStatusTransition {
  fromStatusId Int           @map("from_status_id") @db.SmallInt
  toStatusId   Int           @map("to_status_id") @db.SmallInt
  fromStatus   ProductStatus @relation("ProductTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatus     ProductStatus @relation("ProductTransitionTo", fields: [toStatusId], references: [id], onDelete: Restrict)

  @@id([fromStatusId, toStatusId])
  @@map("product_status_transitions")
}

model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  establishmentId String           @map("establishment_id") @db.Uuid
  menuSectionId   String           @map("menu_section_id") @db.Uuid
  statusId        Int              @map("status_id") @db.SmallInt
  /// Orden dentro de su sección (H02.2).
  sortOrder       Int              @default(0) @map("sort_order") @db.SmallInt
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  establishment   Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  menuSection     MenuSection      @relation(fields: [menuSectionId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  status          ProductStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        ProductVersion[]
  images          ProductImage[]

  @@index([establishmentId])
  @@index([menuSectionId, sortOrder])
  @@map("products")
}

/// Versión inmutable de lo que el cliente acepta al pedir (precio, tiempo y textos).
model ProductVersion {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  price           Decimal              @db.Decimal(12, 2)
  prepMinutes     Int                  @map("prep_minutes") @db.SmallInt
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  texts           ProductVersionText[]
  orderItems      OrderItem[]

  @@unique([productId, createdAt])
  @@map("product_versions")
}

model ProductVersionText {
  productVersionId String         @map("product_version_id") @db.Uuid
  languageId       Int            @map("language_id") @db.SmallInt
  name             String         @db.VarChar(120)
  description      String?
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  language         Language       @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([productVersionId, languageId])
  @@map("product_version_texts")
}

model ProductImage {
  productId String  @map("product_id") @db.Uuid
  fileId    String  @map("file_id") @db.Uuid
  sortOrder Int     @map("sort_order") @db.SmallInt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([productId, fileId])
  @@map("product_images")
}

// ═══════════════════════════ E03 · Zonas, horario y configuración ═══════════════════════════

model ZoneKind {
  id            Int            @id @default(autoincrement()) @db.SmallInt
  code          String         @unique @db.VarChar(40)
  sortOrder     Int            @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  zones         DeliveryZone[]

  @@map("zone_kinds")
}

/// Cómo se trazó la zona: a mano (POLYGON) o como radio alrededor de un centro (CIRCLE). El área siempre
/// es el polígono; centro y radio se derivan de él al leer (no se guardan dos veces).
model ZoneShape {
  id            Int            @id @default(autoincrement()) @db.SmallInt
  code          String         @unique @db.VarChar(40)
  sortOrder     Int            @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  zones         DeliveryZone[]

  @@map("zone_shapes")
}

model DeliveryZone {
  id              String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId  Int                                     @map("municipality_id")
  zoneKindId      Int                                     @map("zone_kind_id") @db.SmallInt
  zoneShapeId     Int                                     @map("zone_shape_id") @db.SmallInt
  name            String                                  @db.VarChar(80)
  area            Unsupported("geography(Polygon, 4326)")
  sortOrder       Int                                     @map("sort_order") @db.SmallInt
  createdByUserId String                                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt   DateTime?                               @map("deactivated_at") @db.Timestamptz(6)
  municipality    Municipality                            @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  zoneKind        ZoneKind                                @relation(fields: [zoneKindId], references: [id], onDelete: Restrict)
  zoneShape       ZoneShape                               @relation(fields: [zoneShapeId], references: [id], onDelete: Restrict)
  createdBy       User                                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  fees            DeliveryZoneFee[]

  @@index([area], type: Gist)
  @@map("delivery_zones")
}

model DeliveryZoneFee {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryZoneId  String       @map("delivery_zone_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  deliveryZone    DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@unique([deliveryZoneId, createdAt])
  @@map("delivery_zone_fees")
}

model OperatingHour {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId  Int          @map("municipality_id")
  weekday         Int          @db.SmallInt
  opensAt         DateTime     @map("opens_at") @db.Time(0)
  closesAt        DateTime     @map("closes_at") @db.Time(0)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt   DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  municipality    Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([municipalityId, weekday])
  @@map("operating_hours")
}

model OperatingHourException {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId Int          @map("municipality_id")
  onDate         DateTime     @map("on_date") @db.Date
  opensAt        DateTime?    @map("opens_at") @db.Time(0)
  closesAt       DateTime?    @map("closes_at") @db.Time(0)
  reason         String?      @db.VarChar(120)
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  /// En SQL con NULLS NOT DISTINCT: un solo "cerrado todo el día" por fecha.
  @@unique([municipalityId, onDate, opensAt], map: "operating_hour_exceptions_unique_idx")
  @@map("operating_hour_exceptions")
}

model SettingDataType {
  id            Int                 @id @default(autoincrement()) @db.SmallInt
  code          String              @unique @db.VarChar(40)
  sortOrder     Int                 @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?           @map("deactivated_at") @db.Timestamptz(6)
  definitions   SettingDefinition[]

  @@map("setting_data_types")
}

model SettingDefinition {
  id                     Int             @id @default(autoincrement()) @db.SmallInt
  key                    String          @unique @db.VarChar(60)
  dataTypeId             Int             @map("data_type_id") @db.SmallInt
  minValue               Decimal?        @map("min_value") @db.Decimal(14, 4)
  maxValue               Decimal?        @map("max_value") @db.Decimal(14, 4)
  isScopedByMunicipality Boolean         @map("is_scoped_by_municipality")
  dataType               SettingDataType @relation(fields: [dataTypeId], references: [id], onDelete: Restrict)
  values                 SettingValue[]

  @@map("setting_definitions")
}

model SettingValue {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingDefinitionId Int               @map("setting_definition_id") @db.SmallInt
  municipalityId      Int?              @map("municipality_id")
  value               Decimal           @db.Decimal(14, 4)
  createdByUserId     String?           @map("created_by_user_id") @db.Uuid
  createdAt           DateTime          @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  settingDefinition   SettingDefinition @relation(fields: [settingDefinitionId], references: [id], onDelete: Restrict)
  municipality        Municipality?     @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  createdBy           User?             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([settingDefinitionId, municipalityId, createdAt])
  @@map("setting_values")
}

model CommissionRate {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId  Int          @map("municipality_id")
  rate            Decimal      @db.Decimal(5, 4)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  municipality    Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@unique([municipalityId, createdAt])
  @@map("commission_rates")
}

model ExchangeRate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyId Int      @map("currency_id") @db.SmallInt
  copPerUnit Decimal  @map("cop_per_unit") @db.Decimal(14, 4)
  source     String   @db.VarChar(60)
  fetchedAt  DateTime @map("fetched_at") @db.Timestamptz(6)
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([currencyId, fetchedAt])
  @@map("exchange_rates")
}

// ═══════════════════════════ E04 · Pedido del cliente ═══════════════════════════

/// Dirección guardada del cliente (H04.2). line, reference y location son inmutables: editar es archivar y crear otra.
model Address {
  id          String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String                                @map("owner_user_id") @db.Uuid
  /// "Casa", "Trabajo". Nulo = dirección de un solo uso (no aparece en la lista del cliente).
  label       String?                               @db.VarChar(40)
  line        String?                               @db.VarChar(200)
  reference   String?                               @db.VarChar(200)
  location    Unsupported("geography(Point, 4326)")
  isDefault   Boolean                               @default(false) @map("is_default")
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime?                             @map("archived_at") @db.Timestamptz(6)
  owner       User                                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([location], type: Gist)
  @@map("addresses")
}

/// Contacto privado del cliente que recibe un pedido para otra persona (no es una persona registrada).
model CustomerRecipient {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  fullName    String    @map("full_name") @db.VarChar(120)
  phoneE164   String?   @map("phone_e164") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@unique([id, ownerUserId])
  @@map("customer_recipients")
}

/// Quién compra: el domiciliario (MVP) o el comercio aliado (E15).
model FulfillmentMode {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  orders        Order[]

  @@map("fulfillment_modes")
}

model OrderStatus {
  id                     Int       @id @default(autoincrement()) @db.SmallInt
  code                   String    @unique @db.VarChar(40)
  sortOrder              Int       @map("sort_order") @db.SmallInt
  deactivatedAt          DateTime? @map("deactivated_at") @db.Timestamptz(6)
  isInitial              Boolean   @map("is_initial")
  isTerminal             Boolean   @map("is_terminal")
  /// Aparece en la línea de tiempo del cliente (RF-50).
  isVisibleToCustomer    Boolean   @map("is_visible_to_customer")
  /// Paso del recorrido normal: la línea de tiempo lo muestra como pendiente aunque aún no llegue.
  isMilestone            Boolean   @map("is_milestone")
  /// Desde aquí el domiciliario ve la dirección exacta y el teléfono de quien recibe.
  revealsDeliveryDetails Boolean   @map("reveals_delivery_details")
  /// Cuenta como entregado (tope de cliente nuevo, comisión, métricas).
  countsAsDelivered      Boolean   @map("counts_as_delivered")
  /// Al llegar aquí se avisa al cliente por push (H06.2), salvo que el cambio lo haya hecho él mismo.
  notifiesCustomer       Boolean   @default(false) @map("notifies_customer")
  /// En este estado el pedido tiene un domiciliario: exactamente una asignación vigente (E07, disparador diferido).
  requiresCourier        Boolean   @default(false) @map("requires_courier")

  orders              Order[]
  transitionsFrom     OrderStatusTransition[]  @relation("OrderTransitionFrom")
  transitionsTo       OrderStatusTransition[]  @relation("OrderTransitionTo")
  historyTo           OrderStatusHistory[]     @relation("OrderHistoryTo")
  incidentResolutions IncidentResolutionType[]

  @@map("order_statuses")
}

/// Máquina de estados del pedido en datos. allows_system: la puede hacer el sistema (geocerca, temporizador).
model OrderStatusTransition {
  fromStatusId Int                         @map("from_status_id") @db.SmallInt
  toStatusId   Int                         @map("to_status_id") @db.SmallInt
  allowsSystem Boolean                     @default(false) @map("allows_system")
  fromStatus   OrderStatus                 @relation("OrderTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatus     OrderStatus                 @relation("OrderTransitionTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  roles        OrderStatusTransitionRole[]
  history      OrderStatusHistory[]

  @@id([fromStatusId, toStatusId])
  @@map("order_status_transitions")
}

/// Qué rol activo puede hacer cada cambio de estado.
model OrderStatusTransitionRole {
  fromStatusId Int                   @map("from_status_id") @db.SmallInt
  toStatusId   Int                   @map("to_status_id") @db.SmallInt
  roleId       Int                   @map("role_id") @db.SmallInt
  transition   OrderStatusTransition @relation(fields: [fromStatusId, toStatusId], references: [fromStatusId, toStatusId], onDelete: Cascade)
  role         Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([fromStatusId, toStatusId, roleId])
  @@map("order_status_transition_roles")
}

/// Por qué medio llegó un cambio de estado: acción de una persona, sincronización sin señal, geocerca o temporizador.
model StatusChangeSource {
  id            Int                  @id @default(autoincrement()) @db.SmallInt
  code          String               @unique @db.VarChar(40)
  sortOrder     Int                  @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?            @map("deactivated_at") @db.Timestamptz(6)
  isAutomatic   Boolean              @map("is_automatic")
  history       OrderStatusHistory[]

  @@map("status_change_sources")
}

/// El pedido guarda solo lo suyo: totales, comisión en pesos y domiciliario se calculan (v_order_amounts, E07).
model Order {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String                   @unique @db.VarChar(12)
  customerUserId     String                   @map("customer_user_id") @db.Uuid
  establishmentId    String                   @map("establishment_id") @db.Uuid
  deliveryAddressId  String                   @map("delivery_address_id") @db.Uuid
  recipientId        String?                  @map("recipient_id") @db.Uuid
  deliveryZoneFeeId  String                   @map("delivery_zone_fee_id") @db.Uuid
  commissionRateId   String                   @map("commission_rate_id") @db.Uuid
  paymentMethodId    Int                      @map("payment_method_id") @db.SmallInt
  fulfillmentModeId  Int                      @map("fulfillment_mode_id") @db.SmallInt
  /// Estado actual: solo lo escribe el disparador de order_status_history.
  statusId           Int                      @map("status_id") @db.SmallInt
  customerNotes      String?                  @map("customer_notes") @db.VarChar(500)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  customer           User                     @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  establishment      Establishment            @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  deliveryAddress    Address                  @relation(fields: [deliveryAddressId, customerUserId], references: [id, ownerUserId], onDelete: Restrict)
  recipient          CustomerRecipient?       @relation(fields: [recipientId, customerUserId], references: [id, ownerUserId], onDelete: Restrict)
  deliveryZoneFee    DeliveryZoneFee          @relation(fields: [deliveryZoneFeeId], references: [id], onDelete: Restrict)
  commissionRate     CommissionRate           @relation(fields: [commissionRateId], references: [id], onDelete: Restrict)
  paymentMethod      PaymentMethod            @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  fulfillmentMode    FulfillmentMode          @relation(fields: [fulfillmentModeId], references: [id], onDelete: Restrict)
  status             OrderStatus              @relation(fields: [statusId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  notifications      Notification[]
  offers             OrderOffer[]
  assignments        OrderAssignment[]
  cashMovements      CashMovement[]
  purchase           OrderPurchase?
  preparationDelays  OrderPreparationDelay[]
  deliveryCode       OrderDeliveryCode?
  deliveryAttempts   DeliveryCodeAttempt[]
  deliveryProof      OrderDeliveryProof?
  adjustmentRequests OrderAdjustmentRequest[]
  cancellation       OrderCancellation?
  incidents          Incident[]

  @@index([customerUserId, createdAt(sort: Desc)])
  @@index([customerUserId, statusId])
  @@index([statusId])
  @@index([establishmentId, createdAt])
  @@map("orders")
}

/// Línea del pedido: nombre, precio y tiempo se leen de la versión del producto (no se copian).
model OrderItem {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String                @map("order_id") @db.Uuid
  productVersionId   String                @map("product_version_id") @db.Uuid
  quantity           Int                   @db.SmallInt
  notes              String?               @db.VarChar(200)
  /// E09: línea sustituta, nacida de la decisión "cambiar por" de esta consulta.
  originAdjustmentId String?               @unique @map("origin_adjustment_id") @db.Uuid
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVersion     ProductVersion        @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  originAdjustment   OrderItemAdjustment?  @relation("SubstituteLine", fields: [originAdjustmentId], references: [id], onDelete: Restrict)
  adjustments        OrderItemAdjustment[] @relation("AdjustedLine")

  @@unique([id, orderId])
  @@index([orderId])
  @@map("order_items")
}

/// Línea de tiempo del pedido: una fila inmutable por cambio de estado.
model OrderStatusHistory {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String                 @map("order_id") @db.Uuid
  fromStatusId    Int?                   @map("from_status_id") @db.SmallInt
  toStatusId      Int                    @map("to_status_id") @db.SmallInt
  changedByUserId String?                @map("changed_by_user_id") @db.Uuid
  actingRoleId    Int?                   @map("acting_role_id") @db.SmallInt
  sourceId        Int                    @map("source_id") @db.SmallInt
  /// Lo genera el dispositivo: reenviar el mismo evento (sin señal o doble toque) no lo duplica.
  clientEventId   String?                @unique @map("client_event_id") @db.Uuid
  occurredAt      DateTime               @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  recordedAt      DateTime               @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(6)
  note            String?                @db.VarChar(300)
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  toStatus        OrderStatus            @relation("OrderHistoryTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  transition      OrderStatusTransition? @relation(fields: [fromStatusId, toStatusId], references: [fromStatusId, toStatusId], onDelete: Restrict)
  changedBy       User?                  @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)
  actingRole      Role?                  @relation(fields: [actingRoleId], references: [id], onDelete: Restrict)
  source          StatusChangeSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  notifications   Notification[]

  @@index([orderId, recordedAt])
  @@map("order_status_history")
}

// ─────────────── E06 · Notificaciones push (Docs/14-base-de-datos/E06-notificaciones.md) ───────────────

/// FCM (Android con Google, iOS) o HMS (Huawei Push Kit, teléfonos sin Google).
model PushProvider {
  id            Int               @id @default(autoincrement()) @db.SmallInt
  code          String            @unique @db.VarChar(40)
  sortOrder     Int               @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  tokens        DevicePushToken[]

  @@map("push_providers")
}

/// Por qué un token push dejó de usarse: la app lo cambió, cerró sesión o el proveedor lo rechazó.
model PushTokenInvalidationReason {
  id            Int               @id @default(autoincrement()) @db.SmallInt
  code          String            @unique @db.VarChar(40)
  sortOrder     Int               @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  tokens        DevicePushToken[]

  @@map("push_token_invalidation_reasons")
}

/// Token push de un dispositivo. El proveedor lo rota: uno vigente por dispositivo y proveedor (índices parciales en SQL).
model DevicePushToken {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId             String                       @map("device_id") @db.Uuid
  pushProviderId       Int                          @map("push_provider_id") @db.SmallInt
  token                String                       @db.VarChar(512)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  invalidatedAt        DateTime?                    @map("invalidated_at") @db.Timestamptz(6)
  invalidationReasonId Int?                         @map("invalidation_reason_id") @db.SmallInt
  device               Device                       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  provider             PushProvider                 @relation(fields: [pushProviderId], references: [id], onDelete: Restrict)
  invalidationReason   PushTokenInvalidationReason? @relation(fields: [invalidationReasonId], references: [id], onDelete: Restrict)
  deliveries           NotificationDelivery[]

  @@index([deviceId])
  @@map("device_push_tokens")
}

/// Qué se avisa. is_high_priority: sonido y prioridad alta en el proveedor (ofertas al domiciliario).
model NotificationType {
  id             Int            @id @default(autoincrement()) @db.SmallInt
  code           String         @unique @db.VarChar(40)
  sortOrder      Int            @map("sort_order") @db.SmallInt
  deactivatedAt  DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  isHighPriority Boolean        @map("is_high_priority")
  notifications  Notification[]

  @@map("notification_types")
}

/// Un aviso para una persona. El texto no se guarda: se arma con el tipo, el pedido y el idioma de quien lo recibe.
model Notification {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId      String                 @map("recipient_user_id") @db.Uuid
  notificationTypeId   Int                    @map("notification_type_id") @db.SmallInt
  orderId              String?                @map("order_id") @db.Uuid
  /// En ORDER_STATUS_CHANGED, el cambio que se avisa: el estado nuevo se lee de ahí.
  orderStatusHistoryId String?                @unique @map("order_status_history_id") @db.Uuid
  /// Solo argumentos de la plantilla que no existen en otra tabla.
  params               Json?
  createdAt            DateTime               @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  /// Cuándo se repartió a los dispositivos (o se descartó por viejo). Nulo = pendiente en la bandeja de salida.
  dispatchedAt         DateTime?              @map("dispatched_at") @db.Timestamptz(6)
  readAt               DateTime?              @map("read_at") @db.Timestamptz(6)
  recipient            User                   @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  type                 NotificationType       @relation(fields: [notificationTypeId], references: [id], onDelete: Restrict)
  order                Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderStatusHistory   OrderStatusHistory?    @relation(fields: [orderStatusHistoryId], references: [id], onDelete: Restrict)
  deliveries           NotificationDelivery[]

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDeliveryStatus {
  id            Int                    @id @default(autoincrement()) @db.SmallInt
  code          String                 @unique @db.VarChar(40)
  sortOrder     Int                    @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?              @map("deactivated_at") @db.Timestamptz(6)
  isInitial     Boolean                @map("is_initial")
  isTerminal    Boolean                @map("is_terminal")
  deliveries    NotificationDelivery[]

  @@map("notification_delivery_statuses")
}

/// Un intento de envío a un token. Un reintento es una fila nueva; el estado da un solo paso (en cola → enviado o fallido).
model NotificationDelivery {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  devicePushTokenId String                     @map("device_push_token_id") @db.Uuid
  statusId          Int                        @map("status_id") @db.SmallInt
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(200)
  errorCode         String?                    @map("error_code") @db.VarChar(80)
  attemptedAt       DateTime                   @default(dbgenerated("clock_timestamp()")) @map("attempted_at") @db.Timestamptz(6)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  devicePushToken   DevicePushToken            @relation(fields: [devicePushTokenId], references: [id], onDelete: Restrict)
  status            NotificationDeliveryStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@index([notificationId])
  @@index([devicePushTokenId])
  @@map("notification_deliveries")
}

// ─────────────── E07 · Asignación por el operador (Docs/14-base-de-datos/E07-asignacion.md) ───────────────

/// SPECIFIC (un domiciliario elegido) o BROADCAST (todos los disponibles). max_recipients nulo = sin tope.
model OfferMode {
  id            Int          @id @default(autoincrement()) @db.SmallInt
  code          String       @unique @db.VarChar(40)
  sortOrder     Int          @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  maxRecipients Int?         @map("max_recipients") @db.SmallInt
  offers        OrderOffer[]

  @@map("offer_modes")
}

/// Respuesta de un domiciliario a una oferta: PENDING y un solo paso a una final (ACCEPTED, REJECTED, EXPIRED, WITHDRAWN).
model OfferRecipientStatus {
  id            Int                   @id @default(autoincrement()) @db.SmallInt
  code          String                @unique @db.VarChar(40)
  sortOrder     Int                   @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?             @map("deactivated_at") @db.Timestamptz(6)
  isInitial     Boolean               @map("is_initial")
  isTerminal    Boolean               @map("is_terminal")
  recipients    OrderOfferRecipient[]

  @@map("offer_recipient_statuses")
}

/// Por qué un domiciliario dejó de tener un pedido.
model AssignmentReleaseReason {
  id            Int               @id @default(autoincrement()) @db.SmallInt
  code          String            @unique @db.VarChar(40)
  sortOrder     Int               @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  assignments   OrderAssignment[]

  @@map("assignment_release_reasons")
}

/// Un envío del operador. Vence en created_at + offers.timeout_seconds del municipio (excepción deliberada).
model OrderOffer {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String                @map("order_id") @db.Uuid
  offerModeId  Int                   @map("offer_mode_id") @db.SmallInt
  /// Operador o administrador. Nulo solo para la asignación automática (E15).
  sentByUserId String?               @map("sent_by_user_id") @db.Uuid
  createdAt    DateTime              @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz(6)
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  mode         OfferMode             @relation(fields: [offerModeId], references: [id], onDelete: Restrict)
  sentBy       User?                 @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)
  recipients   OrderOfferRecipient[]
  assignments  OrderAssignment[]

  @@unique([id, orderId])
  @@index([orderId, createdAt])
  @@map("order_offers")
}

/// A quién se ofreció y qué respondió. La fila es su propio historial (un solo paso).
model OrderOfferRecipient {
  orderOfferId  String               @map("order_offer_id") @db.Uuid
  courierUserId String               @map("courier_user_id") @db.Uuid
  statusId      Int                  @map("status_id") @db.SmallInt
  respondedAt   DateTime?            @map("responded_at") @db.Timestamptz(6)
  offer         OrderOffer           @relation(fields: [orderOfferId], references: [id], onDelete: Restrict)
  courier       CourierProfile       @relation(fields: [courierUserId], references: [userId], onDelete: Restrict)
  status        OfferRecipientStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignment    OrderAssignment?

  @@id([orderOfferId, courierUserId])
  @@index([courierUserId])
  @@map("order_offer_recipients")
}

/// Quién tiene el pedido. Una sola vigente por pedido y por domiciliario (índices únicos parciales en SQL).
model OrderAssignment {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                   @map("order_id") @db.Uuid
  orderOfferId     String                   @map("order_offer_id") @db.Uuid
  courierUserId    String                   @map("courier_user_id") @db.Uuid
  assignedAt       DateTime                 @default(dbgenerated("clock_timestamp()")) @map("assigned_at") @db.Timestamptz(6)
  releasedAt       DateTime?                @map("released_at") @db.Timestamptz(6)
  releaseReasonId  Int?                     @map("release_reason_id") @db.SmallInt
  releasedByUserId String?                  @map("released_by_user_id") @db.Uuid
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offer            OrderOffer               @relation(fields: [orderOfferId, orderId], references: [id, orderId], onDelete: Restrict)
  recipient        OrderOfferRecipient      @relation(fields: [orderOfferId, courierUserId], references: [orderOfferId, courierUserId], onDelete: Restrict)
  releaseReason    AssignmentReleaseReason? @relation(fields: [releaseReasonId], references: [id], onDelete: Restrict)
  releasedBy       User?                    @relation("OrderAssignmentReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)

  @@unique([orderOfferId, courierUserId])
  @@index([orderId])
  @@map("order_assignments")
}

// ─────────────── E08 · Disponibilidad y ubicación (las usa el despacho de E07) ───────────────

/// TOGGLED_OFF, INACTIVITY_TIMEOUT, ACCOUNT_DISABLED.
model AvailabilityEndReason {
  id            Int                         @id @default(autoincrement()) @db.SmallInt
  code          String                      @unique @db.VarChar(40)
  sortOrder     Int                         @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?                   @map("deactivated_at") @db.Timestamptz(6)
  periods       CourierAvailabilityPeriod[]

  @@map("availability_end_reasons")
}

/// Turno "Disponible": se abre al activarse y se cierra al desactivarse. Uno abierto por domiciliario.
model CourierAvailabilityPeriod {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId String                 @map("courier_user_id") @db.Uuid
  startedAt     DateTime               @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?              @map("ended_at") @db.Timestamptz(6)
  endReasonId   Int?                   @map("end_reason_id") @db.SmallInt
  courier       CourierProfile         @relation(fields: [courierUserId], references: [userId], onDelete: Restrict)
  endReason     AvailabilityEndReason? @relation(fields: [endReasonId], references: [id], onDelete: Restrict)

  @@index([courierUserId, startedAt])
  @@map("courier_availability_periods")
}

/// Una lectura de GPS del domiciliario. Nunca llega al cliente; se borra a los location.retention_days.
model CourierLocationPing {
  id            BigInt                                @id @default(autoincrement())
  courierUserId String                                @map("courier_user_id") @db.Uuid
  location      Unsupported("geography(Point, 4326)")
  accuracyM     Decimal?                              @map("accuracy_m") @db.Decimal(6, 1)
  recordedAt    DateTime                              @map("recorded_at") @db.Timestamptz(6)
  receivedAt    DateTime                              @default(now()) @map("received_at") @db.Timestamptz(6)
  courier       CourierProfile                        @relation(fields: [courierUserId], references: [userId], onDelete: Restrict)

  @@index([courierUserId, recordedAt(sort: Desc)])
  @@index([receivedAt])
  @@map("courier_location_pings")
}

// ─────────────── E08 · Compra en el local y preparación (Docs/14-base-de-datos/E08-modo-domiciliario.md) ───────────────
// La compra es un movimiento PURCHASE de la caja del domiciliario: aquí llega la base del libro de E11
// (cash_movement_types, cash_boxes, cash_movements). El cierre, la base entregada y los ajustes llegan con E11.

/// OPENING, PURCHASE, COLLECTION, RETURN, ADJUSTMENT_IN, ADJUSTMENT_OUT. direction: +1 aumenta lo que el domiciliario debe entregar.
model CashMovementType {
  id                           Int            @id @default(autoincrement()) @db.SmallInt
  code                         String         @unique @db.VarChar(40)
  sortOrder                    Int            @map("sort_order") @db.SmallInt
  deactivatedAt                DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  direction                    Int            @db.SmallInt
  requiresOrder                Boolean        @map("requires_order")
  requiresPaymentMethod        Boolean        @map("requires_payment_method")
  isManual                     Boolean        @map("is_manual")
  usesCourierCollectionAccount Boolean        @map("uses_courier_collection_account")
  onlyForFundingModeId         Int?           @map("only_for_funding_mode_id") @db.SmallInt
  onlyForFundingMode           FundingMode?   @relation(fields: [onlyForFundingModeId], references: [id], onDelete: Restrict)
  movements                    CashMovement[]

  @@map("cash_movement_types")
}

/// Caja del domiciliario por día (fecha en la zona horaria del municipio). El saldo se calcula; no se guarda.
model CashBox {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId String         @map("courier_user_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  courier       CourierProfile @relation(fields: [courierUserId], references: [userId], onDelete: Restrict)
  movements     CashMovement[]

  @@unique([courierUserId, businessDate])
  @@map("cash_boxes")
}

/// Todo peso que se mueve de verdad, una fila inmutable. El signo lo da el tipo (amount siempre > 0).
model CashMovement {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashBoxId           String                    @map("cash_box_id") @db.Uuid
  movementTypeId      Int                       @map("movement_type_id") @db.SmallInt
  amount              Decimal                   @db.Decimal(12, 2)
  orderId             String?                   @map("order_id") @db.Uuid
  paymentMethodId     Int?                      @map("payment_method_id") @db.SmallInt
  collectionAccountId String?                   @map("collection_account_id") @db.Uuid
  reversesMovementId  String?                   @unique @map("reverses_movement_id") @db.Uuid
  createdByUserId     String?                   @map("created_by_user_id") @db.Uuid
  note                String?
  createdAt           DateTime                  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  cashBox             CashBox                   @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  movementType        CashMovementType          @relation(fields: [movementTypeId], references: [id], onDelete: Restrict)
  order               Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod?            @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  collectionAccount   CourierCollectionAccount? @relation(fields: [collectionAccountId], references: [id], onDelete: Restrict)
  reverses            CashMovement?             @relation("CashMovementReverses", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy          CashMovement?             @relation("CashMovementReverses")
  createdBy           User?                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  purchases           OrderPurchase[]

  @@unique([id, orderId])
  @@index([cashBoxId])
  @@index([orderId])
  @@map("cash_movements")
}

/// H08.4: la compra en el local. El monto es el movimiento PURCHASE; quién y cuándo, el movimiento y el historial.
model OrderPurchase {
  orderId        String       @id @map("order_id") @db.Uuid
  cashMovementId String       @unique @map("cash_movement_id") @db.Uuid
  receiptFileId  String       @unique @map("receipt_file_id") @db.Uuid
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashMovement   CashMovement @relation(fields: [cashMovementId, orderId], references: [id, orderId], onDelete: Restrict)
  receiptFile    File         @relation(fields: [receiptFileId], references: [id], onDelete: Restrict)

  @@map("order_purchases")
}

/// H08.5: "Sigue en preparación". Retrasado = tiene al menos una fila; el próximo aviso se cuenta desde la última.
model OrderPreparationDelay {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  reportedByUserId String   @map("reported_by_user_id") @db.Uuid
  reportedAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("reported_at") @db.Timestamptz(6)
  /// Lo genera la app: reenviar el mismo aviso desde la cola sin señal no lo duplica (H08.8).
  clientEventId    String?  @unique @map("client_event_id") @db.Uuid
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reportedBy       User     @relation(fields: [reportedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, reportedAt])
  @@map("order_preparation_delays")
}

// ─────────────── Cierre de la entrega (E10 con código de entrega) ───────────────

/// Código de 4 dígitos que el cliente le dice al domiciliario al recibir. Nace cuando el pedido sale del local.
model OrderDeliveryCode {
  orderId   String   @id @map("order_id") @db.Uuid
  code      String   @db.Char(4)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_delivery_codes")
}

/// Cada código equivocado que escribió el domiciliario. Al quinto se bloquea y queda la entrega con foto.
model DeliveryCodeAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  courierUserId String   @map("courier_user_id") @db.Uuid
  attemptedAt   DateTime @default(dbgenerated("clock_timestamp()")) @map("attempted_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier       User     @relation(fields: [courierUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("delivery_code_attempts")
}

/// H10.4: foto de la entrega cuando el cliente no dio el código. Quién y cuándo: files.uploaded_by_user_id y captured_at.
model OrderDeliveryProof {
  orderId String @id @map("order_id") @db.Uuid
  fileId  String @unique @map("file_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  file    File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@map("order_delivery_proofs")
}

// ─────────────── E09 · Producto faltante ───────────────

/// UNAVAILABLE, PRICE_CHANGED. requires_price: la línea consultada lleva el precio nuevo.
model AdjustmentReason {
  id            Int                   @id @default(autoincrement()) @db.SmallInt
  code          String                @unique @db.VarChar(40)
  sortOrder     Int                   @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?             @map("deactivated_at") @db.Timestamptz(6)
  requiresPrice Boolean               @map("requires_price")
  adjustments   OrderItemAdjustment[]

  @@map("adjustment_reasons")
}

/// SUBSTITUTE, REMOVE_ITEM, ACCEPT_PRICE, CANCEL_ORDER, EXPIRED_REMOVED: lo que hace cada decisión, como datos.
model AdjustmentDecision {
  id                Int                   @id @default(autoincrement()) @db.SmallInt
  code              String                @unique @db.VarChar(40)
  sortOrder         Int                   @map("sort_order") @db.SmallInt
  deactivatedAt     DateTime?             @map("deactivated_at") @db.Timestamptz(6)
  removesItem       Boolean               @map("removes_item")
  usesReportedPrice Boolean               @map("uses_reported_price")
  createsSubstitute Boolean               @map("creates_substitute")
  cancelsOrder      Boolean               @map("cancels_order")
  /// La toma el sistema (vencimiento): sin usuario.
  isAutomatic       Boolean               @map("is_automatic")
  adjustments       OrderItemAdjustment[]

  @@map("adjustment_decisions")
}

/// Una consulta del domiciliario al cliente: mueve el pedido a AWAITING_CUSTOMER y tiene el plazo común.
model OrderAdjustmentRequest {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                @map("order_id") @db.Uuid
  reportedByUserId String                @map("reported_by_user_id") @db.Uuid
  reportedAt       DateTime              @default(dbgenerated("clock_timestamp()")) @map("reported_at") @db.Timestamptz(6)
  /// reported_at + adjustments.timeout_seconds del municipio del local.
  expiresAt        DateTime              @map("expires_at") @db.Timestamptz(6)
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reportedBy       User                  @relation(fields: [reportedByUserId], references: [id], onDelete: Restrict)
  lines            OrderItemAdjustment[]

  @@unique([id, orderId])
  @@index([orderId, reportedAt])
  @@map("order_adjustment_requests")
}

/// Una línea consultada y la decisión del cliente (o del sistema al vencer), en la misma fila.
model OrderItemAdjustment {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId         String                 @map("request_id") @db.Uuid
  /// Solo para las llaves compuestas: la línea es del mismo pedido que la consulta.
  orderId           String                 @map("order_id") @db.Uuid
  orderItemId       String                 @map("order_item_id") @db.Uuid
  reasonId          Int                    @map("reason_id") @db.SmallInt
  reportedUnitPrice Decimal?               @map("reported_unit_price") @db.Decimal(12, 2)
  decisionId        Int?                   @map("decision_id") @db.SmallInt
  decidedByUserId   String?                @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?              @map("decided_at") @db.Timestamptz(6)
  request           OrderAdjustmentRequest @relation(fields: [requestId, orderId], references: [id, orderId], onDelete: Restrict)
  orderItem         OrderItem              @relation("AdjustedLine", fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)
  reason            AdjustmentReason       @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  decision          AdjustmentDecision?    @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  decidedBy         User?                  @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  substitute        OrderItem?             @relation("SubstituteLine")

  @@index([requestId])
  @@index([orderItemId])
  @@index([orderId])
  @@map("order_item_adjustments")
}

/// E10 (aquí porque una consulta puede terminar el pedido): CUSTOMER_REQUEST, ALL_ITEMS_UNAVAILABLE, ...
model CancellationReason {
  id            Int                 @id @default(autoincrement()) @db.SmallInt
  code          String              @unique @db.VarChar(40)
  sortOrder     Int                 @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?           @map("deactivated_at") @db.Timestamptz(6)
  isAutomatic   Boolean             @map("is_automatic")
  cancellations OrderCancellation[]

  @@map("cancellation_reasons")
}

/// Por qué se canceló. Quién y cuándo están en la fila → CANCELLED del historial.
model OrderCancellation {
  orderId              String             @id @map("order_id") @db.Uuid
  cancellationReasonId Int                @map("cancellation_reason_id") @db.SmallInt
  notes                String?            @db.VarChar(500)
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason               CancellationReason @relation(fields: [cancellationReasonId], references: [id], onDelete: Restrict)

  @@map("order_cancellations")
}

// ═══════════════════════════ E10 · Incidencias ═══════════════════════════

/// Sistema: qué reporta el cliente (o el operador al revisar una foto). opens_dispute: el pedido pasa a DISPUTED.
model IncidentType {
  id            Int        @id @default(autoincrement()) @db.SmallInt
  code          String     @unique @db.VarChar(40)
  sortOrder     Int        @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?  @map("deactivated_at") @db.Timestamptz(6)
  opensDispute  Boolean    @map("opens_dispute")
  incidents     Incident[]

  @@map("incident_types")
}

/// Sistema: OPEN (inicial), IN_REVIEW (un operador la tomó), RESOLVED (terminal).
model IncidentStatus {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  isInitial     Boolean   @map("is_initial")
  isTerminal    Boolean   @map("is_terminal")

  incidents       Incident[]
  transitionsFrom IncidentStatusTransition[] @relation("IncidentStatusTransitionFrom")
  transitionsTo   IncidentStatusTransition[] @relation("IncidentStatusTransitionTo")
  historyTo       IncidentStatusHistory[]    @relation("IncidentStatusHistoryTo")

  @@map("incident_statuses")
}

model IncidentStatusTransition {
  fromStatusId Int                     @map("from_status_id") @db.SmallInt
  toStatusId   Int                     @map("to_status_id") @db.SmallInt
  fromStatus   IncidentStatus          @relation("IncidentStatusTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     IncidentStatus          @relation("IncidentStatusTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  history      IncidentStatusHistory[]

  @@id([fromStatusId, toStatusId])
  @@map("incident_status_transitions")
}

/// Sistema: cómo se resolvió y a qué estado deja al pedido (nulo: no cambia, p. ej. un reclamo sobre un pedido entregado).
model IncidentResolutionType {
  id                     Int          @id @default(autoincrement()) @db.SmallInt
  code                   String       @unique @db.VarChar(40)
  sortOrder              Int          @map("sort_order") @db.SmallInt
  deactivatedAt          DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  resultingOrderStatusId Int?         @map("resulting_order_status_id") @db.SmallInt
  resultingOrderStatus   OrderStatus? @relation(fields: [resultingOrderStatusId], references: [id], onDelete: Restrict)
  incidents              Incident[]

  @@map("incident_resolution_types")
}

/// Un caso por revisar sobre un pedido. Una sola sin resolver por pedido. Quién la tomó y la resolvió está en su historial.
model Incident {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String                  @map("order_id") @db.Uuid
  incidentTypeId   Int                     @map("incident_type_id") @db.SmallInt
  reportedByUserId String                  @map("reported_by_user_id") @db.Uuid
  description      String?                 @db.VarChar(500)
  statusId         Int                     @map("status_id") @db.SmallInt
  /// Lleno si y solo si está RESOLVED (disparador diferido).
  resolutionTypeId Int?                    @map("resolution_type_id") @db.SmallInt
  resolutionNotes  String?                 @map("resolution_notes") @db.VarChar(500)
  createdAt        DateTime                @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type             IncidentType            @relation(fields: [incidentTypeId], references: [id], onDelete: Restrict)
  reportedBy       User                    @relation(fields: [reportedByUserId], references: [id], onDelete: Restrict)
  status           IncidentStatus          @relation(fields: [statusId], references: [id], onDelete: Restrict)
  resolutionType   IncidentResolutionType? @relation(fields: [resolutionTypeId], references: [id], onDelete: Restrict)
  history          IncidentStatusHistory[]

  @@index([orderId])
  @@index([statusId])
  @@map("incidents")
}

model IncidentStatusHistory {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId      String                    @map("incident_id") @db.Uuid
  fromStatusId    Int?                      @map("from_status_id") @db.SmallInt
  toStatusId      Int                       @map("to_status_id") @db.SmallInt
  changedByUserId String                    @map("changed_by_user_id") @db.Uuid
  occurredAt      DateTime                  @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  incident        Incident                  @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  toStatus        IncidentStatus            @relation("IncidentStatusHistoryTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  transition      IncidentStatusTransition? @relation(fields: [fromStatusId, toStatusId], references: [fromStatusId, toStatusId], onDelete: Restrict)
  changedBy       User                      @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, occurredAt])
  @@map("incident_status_history")
}
