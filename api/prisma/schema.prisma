  name               String                     @db.VarChar(80)
  achCode            String?                    @map("ach_code") @db.VarChar(10)
  sortOrder          Int                        @map("sort_order") @db.SmallInt
  deactivatedAt      DateTime?                  @map("deactivated_at") @db.Timestamptz(6)
  collectionAccounts CourierCollectionAccount[]

  @@map("banks")
}

model BankAccountType {
  id                 Int                        @id @default(autoincrement()) @db.SmallInt
  code               String                     @unique @db.VarChar(40)
  sortOrder          Int                        @map("sort_order") @db.SmallInt
  deactivatedAt      DateTime?                  @map("deactivated_at") @db.Timestamptz(6)
  collectionAccounts CourierCollectionAccount[]

  @@map("bank_account_types")
}

/// Cuentas personales del domiciliario a las que el cliente paga con QR (MVP).
model CourierCollectionAccount {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId     String           @map("courier_user_id") @db.Uuid
  paymentMethodId   Int              @map("payment_method_id") @db.SmallInt
  bankId            Int?             @map("bank_id") @db.SmallInt
  bankAccountTypeId Int?             @map("bank_account_type_id") @db.SmallInt
  accountNumber     String           @map("account_number") @db.VarChar(30)
  holderName        String           @map("holder_name") @db.VarChar(120)
  qrFileId          String?          @map("qr_file_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
