// Esquema normalizado de RapiChonta. Diseño completo y reglas: Docs/14-base-de-datos/.
//
// - Cada estado o clasificación es una tabla catálogo (id + code): no hay enums.
// - Lo que Prisma no sabe expresar (CHECK, índices parciales, NULLS NOT DISTINCT, exclusiones,
//   disparadores, vistas) está en SQL al final de cada migration.sql. Revise toda migración nueva
//   antes de aplicarla y quite cualquier DROP INDEX / DROP TRIGGER que no sea intencional.
// - Las columnas geography son Unsupported: las tablas con una obligatoria se escriben con
//   $executeRaw + Prisma.sql desde su repositorio de infraestructura.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

// La URL de conexión vive en prisma.config.ts (CLI) y en el adaptador pg (cliente).
datasource db {
  provider   = "postgresql"
  extensions = [postgis, citext, btree_gist, unaccent]
}

// ═══════════════════════════ 00 · Transversal ═══════════════════════════

model Country {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  iso2        String       @unique @db.Char(2)
  name        String       @db.VarChar(80)
  departments Department[]

  @@map("countries")
}

model Department {
  id             Int            @id @default(autoincrement()) @db.SmallInt
  countryId      Int            @map("country_id") @db.SmallInt
  daneCode       String         @unique @map("dane_code") @db.Char(2)
  name           String         @db.VarChar(80)
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  municipalities Municipality[]

  @@unique([countryId, name])
  @@map("departments")
}

model Municipality {
  id           Int                                      @id @default(autoincrement())
  departmentId Int                                      @map("department_id") @db.SmallInt
  daneCode     String                                   @unique @map("dane_code") @db.Char(5)
  name         String                                   @db.VarChar(80)
  timeZone     String                                   @map("time_zone") @db.VarChar(40)
  center       Unsupported("geography(Point, 4326)")
  boundary     Unsupported("geography(Polygon, 4326)")?
  launchedAt   DateTime?                                @map("launched_at") @db.Timestamptz(6)
  department   Department                               @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  userRoles               UserRole[]
  establishments          Establishment[]
  deliveryZones           DeliveryZone[]
  operatingHours          OperatingHour[]
  operatingHourExceptions OperatingHourException[]
  settingValues           SettingValue[]
  commissionRates         CommissionRate[]

  @@map("municipalities")
}

model Language {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  userPreferences      UserPreference[]
  categoryTranslations EstablishmentCategoryTranslation[]
  sectionTranslations  MenuSectionTranslation[]
  productVersionTexts  ProductVersionText[]

  @@map("languages")
}

model Currency {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  minorUnits    Int       @map("minor_units") @db.SmallInt
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  userPreferences UserPreference[]
  exchangeRates   ExchangeRate[]

  @@map("currencies")
}

model PaymentMethod {
  id               Int       @id @default(autoincrement()) @db.SmallInt
  code             String    @unique @db.VarChar(40)
  sortOrder        Int       @map("sort_order") @db.SmallInt
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz(6)
  isCashOnDelivery Boolean   @map("is_cash_on_delivery")
  isAccountBased   Boolean   @map("is_account_based")
  requiresBank     Boolean   @map("requires_bank")

  collectionAccounts CourierCollectionAccount[]
  orders             Order[]
  cashMovements      CashMovement[]
  checkoutOption     CheckoutPaymentMethod?

  @@map("payment_methods")
}

/// Cómo se le ofrece al cliente un medio contra entrega en "¿Cómo pagas al recibir?": orden, si se muestra y su imagen.
/// Lo administra el panel; la semilla solo agrega la fila de un medio nuevo y nunca la pisa.
model CheckoutPaymentMethod {
  paymentMethodId Int           @id @map("payment_method_id") @db.SmallInt
  sortOrder       Int           @map("sort_order") @db.SmallInt
  hiddenAt        DateTime?     @map("hidden_at") @db.Timestamptz(6)
  imageFileId     String?       @map("image_file_id") @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  image           File?         @relation(fields: [imageFileId], references: [id], onDelete: Restrict)

  @@map("checkout_payment_methods")
}

model FilePurpose {
  id               Int       @id @default(autoincrement()) @db.SmallInt
  code             String    @unique @db.VarChar(40)
  sortOrder        Int       @map("sort_order") @db.SmallInt
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz(6)
  maxSizeBytes     Int       @map("max_size_bytes")
  allowedMimeTypes String[]  @map("allowed_mime_types")
  requiresCamera   Boolean   @map("requires_camera")

  files File[]

  @@map("file_purposes")
}

model File {
  id               String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purposeId        Int                                    @map("purpose_id") @db.SmallInt
  storageKey       String                                 @unique @map("storage_key") @db.VarChar(300)
  mimeType         String                                 @map("mime_type") @db.VarChar(80)
  sizeBytes        Int                                    @map("size_bytes")
  sha256           String                                 @db.Char(64)
  uploadedByUserId String                                 @map("uploaded_by_user_id") @db.Uuid
  capturedAt       DateTime?                              @map("captured_at") @db.Timestamptz(6)
  capturedLocation Unsupported("geography(Point, 4326)")? @map("captured_location")
  createdAt        DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  purpose          FilePurpose                            @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  uploadedBy       User                                   @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  legalDocumentVersions LegalDocumentVersion[]
  courierDocuments      CourierDocument[]
  collectionAccountQrs  CourierCollectionAccount[]
  establishmentLogos    Establishment[]
  productImages         ProductImage[]
  purchaseReceipts      OrderPurchase[]
  deliveryProofs        OrderDeliveryProof[]
  paymentMethodImages   CheckoutPaymentMethod[]
  content               FileContent?

  @@index([purposeId, sha256])
  @@map("files")
}

/// Bytes del archivo cuando el almacenamiento es la base de datos (FILE_STORAGE=database). 1:1 con files.
model FileContent {
  fileId  String @id @map("file_id") @db.Uuid
  content Bytes
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_contents")
}

model AuditAction {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  logs AuditLog[]

  @@map("audit_actions")
}

/// Registro de auditoría de solo inserción (RNF-07). entity_table + entity_id es una referencia polimórfica.
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  actorUserId String?     @map("actor_user_id") @db.Uuid
  actionId    Int         @map("action_id") @db.SmallInt
  entityTable String      @map("entity_table") @db.VarChar(63)
  entityId    String      @map("entity_id")
  changes     Json?
  ipAddress   String?     @map("ip_address") @db.Inet
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      AuditAction @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([entityTable, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}

// ═══════════════════════════ E01 · Identidad y acceso ═══════════════════════════

model DocumentType {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  countryId     Int?      @map("country_id") @db.SmallInt

  people Person[]

  @@map("document_types")
}

/// Quién es la persona. Nada de acceso vive aquí.
model Person {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  givenNames     String        @map("given_names") @db.VarChar(80)
  familyNames    String?       @map("family_names") @db.VarChar(80)
  documentTypeId Int?          @map("document_type_id") @db.SmallInt
  documentNumber String?       @map("document_number") @db.VarChar(20)
  birthDate      DateTime?     @map("birth_date") @db.Date
  anonymizedAt   DateTime?     @map("anonymized_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  phones       PersonPhone[]
  emails       PersonEmail[]
  user         User?
  consents     PersonConsent[]
  dataRequests DataRequest[]

  @@unique([documentTypeId, documentNumber])
  @@map("people")
}

model PersonPhone {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  phoneE164  String    @unique @map("phone_e164") @db.VarChar(16)
  isPrimary  Boolean   @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  person     Person    @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_phones")
}

model PersonEmail {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  email      String    @unique @db.Citext
  isPrimary  Boolean   @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  person     Person    @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_emails")
}

model UserStatus {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  isInitial     Boolean   @map("is_initial")
  isTerminal    Boolean   @map("is_terminal")
  canSignIn     Boolean   @map("can_sign_in")

  users           User[]
  transitionsFrom UserStatusTransition[] @relation("UserStatusTransitionFrom")
  transitionsTo   UserStatusTransition[] @relation("UserStatusTransitionTo")
  historyTo       UserStatusHistory[]    @relation("UserStatusHistoryTo")

  @@map("user_statuses")
}

model UserStatusTransition {
  fromStatusId Int                 @map("from_status_id") @db.SmallInt
  toStatusId   Int                 @map("to_status_id") @db.SmallInt
  fromStatus   UserStatus          @relation("UserStatusTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     UserStatus          @relation("UserStatusTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  history      UserStatusHistory[]

  @@id([fromStatusId, toStatusId])
  @@map("user_status_transitions")
}

/// Puede entrar al sistema. Los datos personales están en people.
model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId          String     @unique @map("person_id") @db.Uuid
  /// Estado actual: solo lo escribe el disparador de user_status_history.
  statusId          Int        @map("status_id") @db.SmallInt
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  person            Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
  status            UserStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  statusHistory          UserStatusHistory[]          @relation("UserStatusHistoryUser")
  statusChanges          UserStatusHistory[]          @relation("UserStatusHistoryChangedBy")
  roles                  UserRole[]                   @relation("UserRoleUser")
  rolesGranted           UserRole[]                   @relation("UserRoleGrantedBy")
  rolesRevoked           UserRole[]                   @relation("UserRoleRevokedBy")
  preference             UserPreference?
  sessions               Session[]
  authAttempts           AuthAttempt[]
  uploadedFiles          File[]                       @relation("FileUploadedBy")
  auditLogs              AuditLog[]
  legalVersionsCreated   LegalDocumentVersion[]
  dataRequestsResolved   DataRequest[]
  courierProfile         CourierProfile?              @relation("CourierProfileUser")
  couriersCreated        CourierProfile[]             @relation("CourierProfileCreatedBy")
  courierVerifications   CourierVerificationHistory[]
  fundingModesCreated    CourierFundingMode[]
  establishmentsCreated  Establishment[]
  productsCreated        Product[]
  productVersionsCreated ProductVersion[]
  zonesCreated           DeliveryZone[]
  zoneFeesCreated        DeliveryZoneFee[]
  hoursCreated           OperatingHour[]
  settingValuesCreated   SettingValue[]
  commissionRatesCreated CommissionRate[]
  addresses              Address[]
  recipients             CustomerRecipient[]
  orders                 Order[]
  orderStatusChanges     OrderStatusHistory[]
  notifications          Notification[]
  offersSent             OrderOffer[]
  assignmentsReleased    OrderAssignment[]            @relation("OrderAssignmentReleasedBy")
  cashMovementsCreated   CashMovement[]
  preparationDelays      OrderPreparationDelay[]
  deliveryCodeAttempts   DeliveryCodeAttempt[]
  adjustmentsReported    OrderAdjustmentRequest[]
  adjustmentsDecided     OrderItemAdjustment[]
  incidentsReported      Incident[]
  incidentStatusChanges  IncidentStatusHistory[]

  @@index([statusId])
  @@map("users")
}

model UserStatusHistory {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  fromStatusId    Int?                  @map("from_status_id") @db.SmallInt
  toStatusId      Int                   @map("to_status_id") @db.SmallInt
  changedByUserId String?               @map("changed_by_user_id") @db.Uuid
  reason          String?               @db.VarChar(300)
  changedAt       DateTime              @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(6)
  user            User                  @relation("UserStatusHistoryUser", fields: [userId], references: [id], onDelete: Restrict)
  toStatus        UserStatus            @relation("UserStatusHistoryTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  transition      UserStatusTransition? @relation(fields: [fromStatusId, toStatusId], references: [fromStatusId, toStatusId], onDelete: Restrict)
  changedBy       User?                 @relation("UserStatusHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, changedAt])
  @@map("user_status_history")
}

model Role {
  id                   Int       @id @default(autoincrement()) @db.SmallInt
  code                 String    @unique @db.VarChar(40)
  sortOrder            Int       @map("sort_order") @db.SmallInt
  deactivatedAt        DateTime? @map("deactivated_at") @db.Timestamptz(6)
  requiresPassword     Boolean   @map("requires_password")
  isSelfAssignable     Boolean   @map("is_self_assignable")
  isStaff              Boolean   @map("is_staff")
  requiresMunicipality Boolean   @map("requires_municipality")

  permissions          RolePermission[]
  userRoles            UserRole[]
  sessions             Session[]
  legalRequirements    LegalDocumentRequirement[]
  orderTransitionRoles OrderStatusTransitionRole[]
  orderStatusChanges   OrderStatusHistory[]

  @@map("roles")
}

model Permission {
  id            Int              @id @default(autoincrement()) @db.SmallInt
  code          String           @unique @db.VarChar(60)
  module        String           @db.VarChar(40)
  sortOrder     Int              @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(6)
  roles         RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id") @db.SmallInt
  permissionId Int        @map("permission_id") @db.SmallInt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Roles otorgados con su alcance por municipio. Índice único parcial NULLS NOT DISTINCT en SQL.
model UserRole {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  roleId          Int           @map("role_id") @db.SmallInt
  municipalityId  Int?          @map("municipality_id")
  grantedByUserId String?       @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedByUserId String?       @map("revoked_by_user_id") @db.Uuid
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  user            User          @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  municipality    Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  grantedBy       User?         @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?         @relation("UserRoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_roles")
}

model UserPreference {
  userId            String    @id @map("user_id") @db.Uuid
  languageId        Int       @map("language_id") @db.SmallInt
  displayCurrencyId Int?      @map("display_currency_id") @db.SmallInt
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  language          Language  @relation(fields: [languageId], references: [id], onDelete: Restrict)
  displayCurrency   Currency? @relation(fields: [displayCurrencyId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

model Platform {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  devices       Device[]

  @@map("platforms")
}

/// Una instalación de la app o un navegador. Se relaciona con usuarios solo a través de sus sesiones.
model Device {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installationId String            @unique @map("installation_id") @db.Uuid
  platformId     Int               @map("platform_id") @db.SmallInt
  appVersion     String?           @map("app_version") @db.VarChar(20)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  platform       Platform          @relation(fields: [platformId], references: [id], onDelete: Restrict)
  sessions       Session[]
  pushTokens     DevicePushToken[]

  @@map("devices")
}

model SessionEndReason {
  id            Int       @id @default(autoincrement()) @db.SmallInt
  code          String    @unique @db.VarChar(40)
  sortOrder     Int       @map("sort_order") @db.SmallInt
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  sessions      Session[]

  @@map("session_end_reasons")
}

model Session {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  activeRoleId  Int               @map("active_role_id") @db.SmallInt
  deviceId      String?           @map("device_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt       DateTime?         @map("ended_at") @db.Timestamptz(6)
  endReasonId   Int?              @map("end_reason_id") @db.SmallInt
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeRole    Role              @relation(fields: [activeRoleId], references: [id], onDelete: Restrict)
  device        Device?           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  endReason     SessionEndReason? @relation(fields: [endReasonId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, createdAt])
  @@map("sessions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model OtpPurpose {
  id            Int            @id @default(autoincrement()) @db.SmallInt
  code          String         @unique @db.VarChar(40)
  sortOrder     Int            @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  challenges    OtpChallenge[]

  @@map("otp_purposes")
}

model OtpChannel {
  id            Int            @id @default(autoincrement()) @db.SmallInt
  code          String         @unique @db.VarChar(40)
  sortOrder     Int            @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  challenges    OtpChallenge[]

  @@map("otp_channels")
}

/// Código de un solo uso. Nunca guarda el código en claro.
model OtpChallenge {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164         String        @map("phone_e164") @db.VarChar(16)
  purposeId         Int           @map("purpose_id") @db.SmallInt
  channelId         Int           @map("channel_id") @db.SmallInt
  codeHash          String?       @map("code_hash") @db.VarChar(255)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(100)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  ipAddress         String?       @map("ip_address") @db.Inet
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  purpose           OtpPurpose    @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  channel           OtpChannel    @relation(fields: [channelId], references: [id], onDelete: Restrict)
  attempts          AuthAttempt[]

  @@index([phoneE164, createdAt])
  @@map("otp_challenges")
}

model AuthFactor {
  id            Int           @id @default(autoincrement()) @db.SmallInt
  code          String        @unique @db.VarChar(40)
  sortOrder     Int           @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?     @map("deactivated_at") @db.Timestamptz(6)
  attempts      AuthAttempt[]

  @@map("auth_factors")
}

/// Cada intento de código o contraseña. Los límites se cuentan; no hay contadores guardados.
model AuthAttempt {
  id             BigInt        @id @default(autoincrement())
  authFactorId   Int           @map("auth_factor_id") @db.SmallInt
  otpChallengeId String?       @map("otp_challenge_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  succeeded      Boolean
  ipAddress      String?       @map("ip_address") @db.Inet
  attemptedAt    DateTime      @default(now()) @map("attempted_at") @db.Timestamptz(6)
  authFactor     AuthFactor    @relation(fields: [authFactorId], references: [id], onDelete: Restrict)
  otpChallenge   OtpChallenge? @relation(fields: [otpChallengeId], references: [id], onDelete: Restrict)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([otpChallengeId])
  @@index([userId, attemptedAt])
