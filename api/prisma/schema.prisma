// ─────────────── Domiciliarios ───────────────

model CourierVerificationStatus {
  id               Int       @id @default(autoincrement()) @db.SmallInt
  code             String    @unique @db.VarChar(40)
  sortOrder        Int       @map("sort_order") @db.SmallInt
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz(6)
  isInitial        Boolean   @map("is_initial")
  isTerminal       Boolean   @map("is_terminal")
  canReceiveOffers Boolean   @map("can_receive_offers")

  profiles        CourierProfile[]
  transitionsFrom CourierVerificationTransition[] @relation("CourierVerificationTransitionFrom")
  transitionsTo   CourierVerificationTransition[] @relation("CourierVerificationTransitionTo")
  historyTo       CourierVerificationHistory[]    @relation("CourierVerificationHistoryTo")

  @@map("courier_verification_statuses")
}

model CourierVerificationTransition {
  fromStatusId Int                          @map("from_status_id") @db.SmallInt
  toStatusId   Int                          @map("to_status_id") @db.SmallInt
  fromStatus   CourierVerificationStatus    @relation("CourierVerificationTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus     CourierVerificationStatus    @relation("CourierVerificationTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)
  history      CourierVerificationHistory[]

  @@id([fromStatusId, toStatusId])
  @@map("courier_verification_transitions")
}

model CourierProfile {
  userId               String                    @id @map("user_id") @db.Uuid
  /// Estado actual: solo lo escribe el disparador de courier_verification_history.
  verificationStatusId Int                       @map("verification_status_id") @db.SmallInt
  createdByUserId      String                    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 User                      @relation("CourierProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  verificationStatus   CourierVerificationStatus @relation(fields: [verificationStatusId], references: [id], onDelete: Restrict)
  createdBy            User                      @relation("CourierProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  verificationHistory CourierVerificationHistory[]
  fundingModes        CourierFundingMode[]
  vehicles            Vehicle[]
  documents           CourierDocument[]
  collectionAccounts  CourierCollectionAccount[]
  offersReceived      OrderOfferRecipient[]
  availabilityPeriods CourierAvailabilityPeriod[]
  locationPings       CourierLocationPing[]
  cashBoxes           CashBox[]

  @@map("courier_profiles")
}

model CourierVerificationHistory {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId   String                         @map("courier_user_id") @db.Uuid
  fromStatusId    Int?                           @map("from_status_id") @db.SmallInt
  toStatusId      Int                            @map("to_status_id") @db.SmallInt
  changedByUserId String?                        @map("changed_by_user_id") @db.Uuid
  reason          String?                        @db.VarChar(300)
  changedAt       DateTime                       @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(6)
  courier         CourierProfile                 @relation(fields: [courierUserId], references: [userId], onDelete: Restrict)
  toStatus        CourierVerificationStatus      @relation("CourierVerificationHistoryTo", fields: [toStatusId], references: [id], onDelete: Restrict)
  transition      CourierVerificationTransition? @relation(fields: [fromStatusId, toStatusId], references: [fromStatusId, toStatusId], onDelete: Restrict)
  changedBy       User?                          @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([courierUserId, changedAt])
  @@map("courier_verification_history")
}

model FundingMode {
  id            Int                  @id @default(autoincrement()) @db.SmallInt
  code          String               @unique @db.VarChar(40)
  sortOrder     Int                  @map("sort_order") @db.SmallInt
  deactivatedAt DateTime?            @map("deactivated_at") @db.Timestamptz(6)
  courierModes  CourierFundingMode[]
  movementTypes CashMovementType[]

  @@map("funding_modes")
}

/// Modo de financiación versionado por fecha: el de un día es la última fila con effective_on <= ese día.
model CourierFundingMode {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId   String         @map("courier_user_id") @db.Uuid
  fundingModeId   Int            @map("funding_mode_id") @db.SmallInt
  effectiveOn     DateTime       @map("effective_on") @db.Date
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
